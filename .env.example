# Copy to .env.local and fill in real values before running.

# Set to "true" to route API calls through the BFF proxy to the backend.
NEXT_PUBLIC_USE_LIVE_API=true

# Google OAuth client ID (create at console.cloud.google.com/apis/credentials).
# Add http://localhost:3000 to Authorised JavaScript origins and redirect URIs.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# System owner tenant ID (from the backend).
API_TENANT_ID=

# HMAC secret used to sign BFF login requests (must match the backend).
LOGIN_HMAC_SECRET=

# Set to "false" when running over plain HTTP (e.g. Docker on localhost).
# Cookies are always Secure in production HTTPS; override only for local HTTP installs.
COOKIE_SECURE=
